# FEZI AGENT v0.77 — Node.js 22
APP_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-different-long-secret
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false
DATA_DIR=./data
# The AI model runtime must be reachable from the server, never expose raw Ollama publicly.
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=gemma3:4b
# Optional cloud APIs (they are NOT automatically free)
AI_BASE_URL=
AI_API_KEY=
COMPATIBLE_MODEL=qwen2.5-coder:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional AI collaboration: planner -> writer -> reviewer
TEAM_PLANNER_PROVIDER=openrouter
TEAM_PLANNER_MODEL=gemma3:4b
TEAM_REVIEW_PROVIDER=
TEAM_REVIEW_MODEL=
# Set a public root outside source/data for live subdomain hosting.
BASE_DOMAIN=
PUBLISHED_ROOT=
# GitHub: use a fine-grained token with Contents / Pull requests write permissions.
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=
# Compatible host adapter receiver you control (HTTPS + verified HMAC)
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_SECRET=
# Telegram bot is not active without credentials + setWebhook operation
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBAPP_URL=
# DEV ONLY: Basic shared-key MCP. Never expose publicly as the production ChatGPT plugin.
MCP_DEV_TOKEN=

# v0.4: comma-separated exact public hostname allowlist for static website inspection.
# Never allow arbitrary internet hosts from untrusted clients; private IPs are blocked.
WEB_IMPORT_ALLOWED_HOSTS=
# Optional comma-separated backup providers used if primary provider fails.
AGENT_FALLBACK_PROVIDERS=
# Optional list of OpenAI-compatible providers; keep API key in matching env variables.
AI_PROVIDERS_JSON=[]
# Optional authorized bridge adapters, HTTPS only; sends task text, not env secrets.
AGENT_BRIDGES_JSON={}
# Telegram agent's configured provider.
TELEGRAM_AGENT_PROVIDER=ollama

# v0.6: GGUF inference on this Node.js machine, zero cloud API calls.
# Never enable unless sufficient RAM/CPU and native addon is installed.
LOCAL_AI_ENABLED=false
LOCAL_DEFAULT_MODEL=coder-mini
LOCAL_MODEL_DIR=./models
LOCAL_CONTEXT_TOKENS=2048
LOCAL_MAX_TOKENS=768
# Optional compatible LoRA GGUF adapter filename under models/adapters/
LOCAL_LORA_FILE=

# v1.0: model routing used by FEZI AGENT. Local-first minimizes API usage.
FEZI_ROUTING_PREFERENCE=local-first

# v0.77: Optional dedicated inference worker (no inference is simulated).
# HTTPS required unless connecting to localhost. Prefer a private network with authentication.
FEZI_WORKER_URL=
FEZI_WORKER_TOKEN=
FEZI_WORKER_TIMEOUT_MS=60000

# Telegram: choose polling (local) OR webhook (cPanel HTTPS)
TELEGRAM_MODE=polling
TELEGRAM_BACKEND_URL=http://127.0.0.1:3000
TELEGRAM_PUBLIC_URL=

# Optional, separate login for code-server running on your own Docker host
FEZI_EDITOR_PASSWORD=

# Optional GPU avatar batch-video worker (not available on most shared cPanel hosts)
# AVATAR_WORKER_URL=https://your-private-gpu-worker.example.com
# AVATAR_WORKER_TOKEN=replace-with-a-long-random-secret

# Arina gallery payment integration (OFF by default; do not enable without verified chain processor and REAL user accounts)
ARINA_PAYMENT_PROVIDER_READY=false
ARINA_IDENTITY_VERIFIED=false
# ARINA_PAYMENT_WEBHOOK_SECRET=set_real_random_32_plus_bytes_only_after_provider_integration
ARINA_PRIVATE_VIDEO_READY=false

# FEZI Studio free/open-weight integration v1.2
# Runtime calls use your OWN local Ollama or private GPU machine; no paid third-party API is requested.
FEZI_OWNER_UNLIMITED=true
FEZI_GPU_WORKER_URL=
FEZI_GPU_WORKER_TOKEN=
# GPU machine ONLY: private ComfyUI endpoint used by gpu-worker-reference/server.py
# COMFYUI_URL=http://127.0.0.1:8188
# WORKER_BIND=127.0.0.1
# WORKER_PORT=8055

# v1.3 PRIVATE ChatGPT plugin preview: strong independent token, must not be shared.
# Public ChatGPT plugin submission needs OAuth 2.1 and HTTPS, this is NOT production authentication.
FEZI_MCP_READ_TOKEN=

# FEZI v1.5 public features (no secret values in Git or chat)
PUBLIC_BASE_URL=https://YOUR-REAL-DOMAIN.example
# Explicitly enable only legacy catalog model IDs AFTER installing the corresponding runtime and model.
STUDIO_ENABLED_MODELS=
# Public GPU jobs: OFF until worker costs, verified model setup, moderation and quotas are ready.
STUDIO_PUBLIC_GPU_ENABLED=false
# Existing cPanel GitHub deploy workflow can publish Node.js code, but GitHub cannot run a persistent website backend by itself.
# Run public bot as a separate process OR use a server-side webhook implementation (not bundled).
# TELEGRAM_MODE=public-polling
# TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_TOKEN=
# Site e-mail verification / Google OAuth / automated crypto crediting are intentionally NOT enabled.

# v1.01 external services (optional; never commit real values)
RESEND_API_KEY=
EMAIL_FROM=
# OAuth Web App settings: REQUIRED on the production server, NEVER commit secrets.
# Create an OAuth Web Application in Google Cloud (Auth Platform -> Clients).
# Authorized JavaScript origins: https://YOUR-DOMAIN
# Authorized redirect URI: https://YOUR-DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy aliases are still accepted by FEZI Studio:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY_ID=
YOUTUBE_RTMP_KEY=
INSTAGRAM_RTMP_URL=
ARINA_STREAM_ENABLED=false
ARINA_CONFIRM_BROADCAST=NO
# Private knowledge: bounded to 200MB via core/knowledge-v101.js

# FEZI STUDIO v1.01 continuation - security + creator marketplace
# The signup CAPTCHA is required in production whenever this module is mounted.
CAPTCHA_REQUIRED=true
# Localized pages are indexed only when actual page text has been authored.
# PUBLIC_BASE_URL is defined above; do not duplicate it here.
# Account verification email (leave disabled until delivery is configured and tested).
RESEND_API_KEY=
EMAIL_FROM=
# Arina uses real AI replies only when explicitly configured; no scripted fallback by default.
ARINA_AI_ENABLED=false
ARINA_DEMO_MODE=false
# No verified crypto checkout/settlement implementation is bundled. Never enable real credits by toggling env only.
# Do not store Google/Apple OAuth client secrets here until the provider integration is implemented and validated.

# Telegram Mini Apps — independent tokens for separate bots. Configure over HTTPS.
# Run only one consumer per token (polling OR webhook). Never share tokens in chats.
TELEGRAM_FEZI_BOT_TOKEN=
TELEGRAM_ARINA_BOT_TOKEN=
TELEGRAM_ARINA_BOT_USERNAME=
# Use PUBLIC_BASE_URL=https://your-actual-domain.example (no path).
# Menu button: npm run telegram:miniapps:setup -- --bot=fezi --apply
# Menu button: npm run telegram:miniapps:setup -- --bot=arina --apply

# Telegram v1.01 shared FEZI account bridge (keep ALL actual values private)
# Every bot must be separately created via @BotFather; do NOT reuse tokens.
TELEGRAM_FEZI_BOT_TOKEN=
TELEGRAM_FEZI_BOT_USERNAME=
TELEGRAM_ARINA_BOT_TOKEN=
TELEGRAM_ARINA_BOT_USERNAME=
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=
# Generate random >=32 bytes (e.g. openssl rand -hex 32); this is NOT a Telegram bot token.
TELEGRAM_INTERNAL_TOKEN=
# HTTPS URL of actual running website; required for Mini Apps and share links.
# PUBLIC_BASE_URL is defined above; do not duplicate it here.
# Separate Node workers require a persistent process; for shared cPanel check hosting limits.
# TELEGRAM_MODE=public-polling

# Telegram 3/day image generation — optional, requires a trusted image worker
FEZI_TELEGRAM_IMAGE_WORKER_URL=
FEZI_TELEGRAM_IMAGE_WORKER_TOKEN=
# Public Telegram worker MUST use one instance only, with HTTPS Mini App and local FEZI backend.
# TELEGRAM_FEZI_BOT_TOKEN=
# TELEGRAM_ARINA_BOT_TOKEN=
# TELEGRAM_LOGIN_BOT_TOKEN=

# FEZI Agent: all normal users free; do not expose keys or spend paid models automatically.
FEZI_AGENT_FREE_ONLY=true
# OpenRouter free-limited route; enable only after verifying quota/terms.
FEZI_FREE_ROUTING_ENABLED=false
FEZI_FREE_CHAT_PER_USER_DAY=3
FEZI_FREE_CHAT_GLOBAL_DAY=20
FEZI_FREE_COMPATIBLE_PROVIDER=false

# Optional approved hosted Hugging Face Spaces. Each URL MUST be publicly embeddable and approved by its owner.
# JSON array of objects, e.g. {"id":"demo","name":"Approved Demo","task":"video","url":"https://actual-space-id.hf.space/"}.
# Do NOT paste real private keys here, and do not bypass a third-party website's limits.
FEZI_APPROVED_HF_SPACES_JSON=[]

# FEZI API Keys separate paid catalog; these are SERVER ENV ONLY, not bundled in GitHub
OPENROUTER_API_KEY=
FEZI_RESELLER_OPENROUTER_KEY=
HF_TOKEN=
# When owner has verified that these existing addresses actually belong to FEZI
FEZI_WALLET_ADDRESSES_REVIEWED=false
# Required for browser-to-mobile wallet pairing via WalletConnect (future SDK integration)
REOWN_PROJECT_ID=
# Do NOT enable flags that claim settlement before external chain verifier is independently tested.
FEZI_API_BILLING_VERIFIED=false
FEZI_API_SETTLEMENT_VERIFIED=false
FEZI_API_METERING_VERIFIED=false

# FEZI authorized cloud video; OFF by default to prevent surprise costs.
# HF_TOKEN must have Inference Providers permissions, provider credits and appropriate license.
FEZI_HF_VIDEO_ENABLED=false
FEZI_HF_VIDEO_COST_APPROVED=false
FEZI_HF_VIDEO_ALLOWED_MODELS=wan22
FEZI_HF_VIDEO_GLOBAL_DAILY_LIMIT=2
FEZI_HF_VIDEO_USER_DAILY_LIMIT=1
# Count limits do not enforce a USD spending ceiling; monitor provider billing separately.

# Arina can reply independently when the FEZI site is offline using free models only.
ARINA_STANDALONE_CHAT_ENABLED=false
ARINA_FREE_MODEL=openrouter/free
ARINA_FREE_CHAT_PER_USER_DAY=5
ARINA_FREE_CHAT_GLOBAL_DAY=20

# Bot profiles / miniapps - set only on private host. Never commit production credentials.
# TELEGRAM_BOT_1_TOKEN= (Telegram Bot Maker)
# TELEGRAM_BOT_2_TOKEN= (FEZI Image Lab)
# TELEGRAM_BOT_5_TOKEN= (FEZI Video Lab)
# TELEGRAM_BOT_6_TOKEN= (FEZI Code Pilot)
# TELEGRAM_BOT_8_TOKEN= (FEZI Help Desk)
# ANNOUNCEMENT_BOT_TOKEN=
# PDH_AI_TELEGRAM_BOT_TOKEN=
# KAIZER_AI_BOT_TOKEN=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# SPEECHIFY_API_KEY=
# PERPLEXITY_API_KEY=
# RESEND_API_KEY=
# ROUTEWAY_API_KEY=

# Optional: publish ONE persistent link to an authorized Telegram channel.
# ARINA_CHANNEL_ID=@your_channel_or_-100_numeric_id
# ARINA_CHANNEL_PUBLISH_ALLOWED=false
# ARINA_CHANNEL_MESSAGE_ID=  # For --edit instead of posting twice

# ARINA_ALLOW_REMOVE_WEBHOOK=false  # Set true only when intentionally migrating from webhook to polling.

# Social Login (server-only; use secret manager, never commit real values)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Currently restricted to approved OpenAI partners; not a self-service generic OAuth:
CHATGPT_LOGIN_PARTNER_APPROVED=false
# Set the real HTTPS origin of your FEZI Studio site:
# PUBLIC_BASE_URL=https://your-domain.example
# COOKIE_SECURE=true

# FEZI API-FIRST: MODEL SAFETY (never commit real secrets)
FEZI_AGENT_FREE_ONLY=true
FEZI_FREE_ROUTING_ENABLED=true
FEZI_ROUTING_PREFERENCE=quality-first
# Ollama hosted API is NOT necessarily free; explicit opt-in only
OLLAMA_CLOUD_ENABLED=false
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=
# Optional providers require separate billing review before configuring
MISTRAL_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
SPEECHIFY_API_KEY=
# For browser voice, no key is needed. Whisper.cpp tiny multilingual (~75MiB) can be installed later on CPU.
FEZI_VOICE_ENGINE=browser
WHISPER_CPP_EXECUTABLE=
WHISPER_CPP_MODEL=
# Telegram BotFather tokens must be fresh and kept server-side; examples intentionally blank
TELEGRAM_FEZI_STUDIO_TOKEN=
TELEGRAM_ARINA_TOKEN=
TELEGRAM_FAST_LOGIN_TOKEN=
TELEGRAM_FEZI_NEWS_TOKEN=
TELEGRAM_FEZIPAY_TOKEN=
# MongoDB requires a freshly rotated password
MONGODB_URI=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FEZI Studio Telegram Factory · never commit actual BotFather tokens
TELEGRAM_FACTORY_BOT_TOKEN=
TELEGRAM_FACTORY_WEBHOOK_SECRET=
TELEGRAM_FACTORY_ADMIN_CHAT_IDS=
# PUBLIC_BASE_URL must be a live, public HTTPS origin before setup

# Public read-only model/repository discovery (no automatic install / publish)
FEZI_DISCOVERY_AUTO_REFRESH=false
FEZI_DISCOVERY_ADMIN_REFRESH=false
GITHUB_DISCOVERY_TOKEN=

# FEZI Agent explicit owner-only diagnostics (NO arbitrary shell)
FEZI_AGENT_SHELL_ENABLED=false

# FEZI Agent private MCP — never expose with shared token to public users
FEZI_AGENT_MCP_TOKEN=

# FEZI Telegram centralized bot — fill with NEW BotFather token; DO NOT reuse keys published in chats
TELEGRAM_FACTORY_BOT_TOKEN=
TELEGRAM_FACTORY_WEBHOOK_SECRET=
TELEGRAM_FACTORY_ADMIN_CHAT_IDS=
PUBLIC_BASE_URL=https://replace-with-your-real-domain.example
FEZI_AGENT_FREE_ONLY=true
# Hosting must use COOKIE_SECURE=true behind HTTPS

# FEZI Studio commercial models and prepaid credit accounts (OFF unless configured)
# Use a newly rotated server-side secret; do not commit it.
FEZI_COMMERCIAL_OPENROUTER_ENABLED=false
FEZI_RESELLER_OPENROUTER_KEY=
# Operator-verified current TOMAN / 1 USD rate. Example is intentionally blank.
FEZI_TOMAN_PER_USD=
# Operator-only reconciliation after independently verified payment (disabled by default).
FEZI_MANUAL_CREDIT_CONFIRM_ENABLED=false
# Incoming bank/card/crypto provider processing and automatic settlement not configured.
FEZI_AUTO_PAYMENT_ENABLED=false
# Public HTTPS base URL; do not use localhost for production Telegram webhooks.
PUBLIC_BASE_URL=
TELEGRAM_FACTORY_BOT_TOKEN=
TELEGRAM_FACTORY_WEBHOOK_SECRET=
TELEGRAM_FACTORY_ADMIN_CHAT_IDS=

# Remote management from Telegram OR ChatGPT: use fresh secrets, not values ever pasted in chat.
# Remote MCP requires owner-configured secret token, >=32 random characters.
FEZI_AGENT_MCP_TOKEN=
# Telegram owner IDs (numeric Telegram IDs, comma-separated), webhook verified by secret header.
TELEGRAM_FACTORY_ADMIN_CHAT_IDS=

# FEZI Scholar + Website Controller MCP (secrets must be new and server-side only)
# FEZI_AGENT_MCP_TOKEN=<generate unique random 32+ character string>
# PUBLIC_BASE_URL=https://your-real-domain.example
# FEZI_DISCOVERY_AUTO_REFRESH=true     # metadata only; doesn't install untrusted code
# NOTE: Connecting ChatGPT requires a supported OAuth/auth integration beyond a bearer-only MCP.

# FEZI Plugin Hub (keep real tokens in host environment, never GitHub)
# FEZI_PLUGIN_HUB_TOKEN=generate-new-random-string-at-least-32-characters
# FEZI_PLUGIN_UPSTREAMS_JSON={"easygit":{"url":"https://YOUR_UPSTREAM_HOST/mcp","tokenEnv":"EASYGIT_UPSTREAM_TOKEN"}}
# EASYGIT_UPSTREAM_TOKEN=replace-on-private-host
# FEZI_MCP_ALLOW_HTTP_LOCAL=false
