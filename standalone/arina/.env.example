TELEGRAM_ARINA_BOT_TOKEN=replace-in-private-host-secrets
OPENROUTER_API_KEY=replace-in-private-host-secrets
ARINA_STANDALONE_CHAT_ENABLED=true
ARINA_FREE_MODEL=openrouter/free
ARINA_FREE_CHAT_PER_USER_DAY=5
ARINA_FREE_CHAT_GLOBAL_DAY=20
DATA_DIR=./data
# Optional, only if showing the FEZI Mini App:
# PUBLIC_BASE_URL=https://your-fezi-domain.example
# TELEGRAM_INTERNAL_TOKEN=strong-secret-for-optional-bridge

# Optional, own or authorized channel only:
# ARINA_CHANNEL_ID=@your_channel
# ARINA_CHANNEL_PUBLISH_ALLOWED=false
# ARINA_CHANNEL_MESSAGE_ID=
# ARINA_ALLOW_REMOVE_WEBHOOK=false
